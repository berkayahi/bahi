---
import { getCollection, getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";

const site = await getEntry("settings", "site");
if (!site) throw new Error("Missing src/content/settings/site.yaml");

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base title={site.data.projects_label}>
  <p class="label reveal">{site.data.projects_label}</p>
  <h1 class="reveal">{site.data.projects_heading}</h1>
  <div class="projects-grid reveal">
    {projects.map((project) => (
      <a class="project-card" href={`/projects/${project.id}`}>
        <img src={project.data.image} alt={project.data.title} loading="lazy" />
        <span class="caption">
          {project.data.subtitle && <p>{project.data.subtitle}</p>}
          <h3>{project.data.title}</h3>
        </span>
      </a>
    ))}
  </div>
</Base>

<style>
  h1 {
    font-size: 1.9rem;
    margin-block: 0.4rem 1.5rem;
  }
</style>
