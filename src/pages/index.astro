---
import { getCollection, getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";

const home = await getEntry("pages", "home");
if (!home) throw new Error("Missing src/content/pages/home.md");
const { Content: Intro } = await render(home);

const site = await getEntry("settings", "site");
if (!site) throw new Error("Missing src/content/settings/site.yaml");

const posts = (await getCollection("thoughts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const fmt = new Intl.DateTimeFormat("en", { day: "2-digit", month: "short", year: "2-digit" });
---

<Base>
  <section class="hero reveal">
    <h1>{home.data.title}</h1>
    <div class="intro">
      <Intro />
    </div>
  </section>

  <section class="reveal">
    <p class="label">{site.data.thoughts_label}</p>
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={`/thoughts/${post.id}`}>{post.data.title}</a>
          <span class="leader"></span>
          <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
        </li>
      ))}
    </ul>
    <p class="more"><a href="/thoughts">View all →</a></p>
  </section>

  <section class="reveal">
    <p class="label">{site.data.projects_label}</p>
    <div class="projects-grid">
      {projects.map((project) => (
        <a class="project-card" href={`/projects/${project.id}`}>
          <img src={project.data.image} alt={project.data.title} loading="lazy" />
          <span class="caption">
            {project.data.subtitle && <p>{project.data.subtitle}</p>}
            <h3>{project.data.title}</h3>
          </span>
        </a>
      ))}
    </div>
    <p class="more"><a href="/projects">View all →</a></p>
  </section>
</Base>

<style>
  .hero {
    padding-block: 2.5rem 3rem;
  }

  .hero h1 {
    font-size: 1.9rem;
    margin-bottom: 0.9rem;
  }

  .intro {
    max-width: 36rem;
    color: var(--muted);
  }

  .intro :global(p) {
    margin-block: 0.5em;
  }

  section + section {
    margin-top: 3.5rem;
  }

  .more {
    margin-top: 0.75rem;
    font-size: 0.9rem;
  }

  .more a {
    text-decoration: none;
    color: var(--muted);
  }
</style>
