---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const posts = (await getCollection("thoughts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

const fmt = new Intl.DateTimeFormat("en", { month: "short", day: "numeric", year: "numeric" });
---

<Base title="Berkay Ahi">
  <section class="hero reveal">
    <p class="label">Software engineer</p>
    <h1>I build software and<br />write down what I learn<span class="dot">.</span></h1>
    <p class="intro">
      This is my corner of the web — essays, notes, and a <a href="/cv">CV</a> that stays current.
      The whole site is an open-source repository;
      the <a href="/thoughts/building-in-the-open">first post</a> explains why.
    </p>
  </section>

  <section class="reveal">
    <p class="label">Recent thoughts</p>
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={`/thoughts/${post.id}`}>{post.data.title}</a>
          <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
        </li>
      ))}
    </ul>
    <p class="all"><a href="/thoughts">All thoughts →</a></p>
  </section>
</Base>

<style>
  .hero {
    padding-block: 3rem 4rem;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    margin-block: 0.75rem 1.25rem;
  }

  .dot {
    color: var(--rust);
  }

  .intro {
    max-width: 34rem;
    color: var(--faded);
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin-block: 1rem;
  }

  .post-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--hairline);
  }

  .post-list a {
    font-family: var(--serif-display);
    font-weight: 600;
    font-size: 1.15rem;
    text-decoration: none;
  }

  .post-list a:hover {
    color: var(--rust);
  }

  .post-list time {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--faded);
    white-space: nowrap;
  }

  .all {
    margin-top: 1.25rem;
    font-family: var(--mono);
    font-size: 0.85rem;
  }
</style>
