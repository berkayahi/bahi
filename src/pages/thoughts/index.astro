---
import { getCollection, getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";

const site = await getEntry("settings", "site");
if (!site) throw new Error("Missing src/content/settings/site.yaml");

const posts = (await getCollection("thoughts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = new Intl.DateTimeFormat("en", { day: "2-digit", month: "short", year: "2-digit" });
---

<Base title={site.data.thoughts_label}>
  <p class="label reveal">{site.data.thoughts_label}</p>
  <h1 class="reveal">{site.data.thoughts_heading}</h1>
  <ul class="post-list reveal">
    {posts.map((post) => (
      <li>
        <a href={`/thoughts/${post.id}`}>{post.data.title}</a>
        <span class="leader"></span>
        <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
      </li>
    ))}
  </ul>
</Base>

<style>
  h1 {
    font-size: 1.9rem;
    margin-block: 0.4rem 1rem;
  }
</style>
