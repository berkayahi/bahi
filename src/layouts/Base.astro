---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Personal site of Berkay Ahi — thoughts, projects, about." } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "/thoughts", label: "Thoughts" },
  { href: "/about", label: "About" },
];
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      document.documentElement.dataset.theme = localStorage.getItem("theme") ?? "dark";
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header>
      <a class="wordmark" href="/">Berkay Ahi</a>
      <nav>
        {nav.map(({ href, label }) => (
          <a href={href} aria-current={isActive(href) ? "page" : undefined}>{label}</a>
        ))}
        <button id="theme-toggle" aria-label="Toggle light mode" title="Toggle light mode">
          <svg class="sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
          <svg class="moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
          </svg>
        </button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <span>© {new Date().getFullYear()} Berkay Ahi — <a href="https://github.com/berkayahi/bahi">source</a></span>
      <span class="social">
        <a href="https://github.com/berkayahi" aria-label="GitHub" title="GitHub">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.75 2.69 1.25 3.34.95.1-.74.4-1.25.72-1.53-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.73.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.66.8.55A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/>
          </svg>
        </a>
        <a href="https://www.linkedin.com/in/berkayahi" aria-label="LinkedIn" title="LinkedIn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0Z"/>
          </svg>
        </a>
      </span>
    </footer>
    <script is:inline>
      document.getElementById("theme-toggle").addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("theme", next);
      });
    </script>
  </body>
</html>

<style>
  header {
    width: min(var(--measure), 100% - 3rem);
    margin-inline: auto;
    padding-block: 2.25rem 0;
  }

  .wordmark {
    font-weight: 700;
    font-size: 1.35rem;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    margin-top: 0.9rem;
  }

  nav a {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    padding-block: 0.2rem;
  }

  nav a:hover {
    color: var(--ink);
  }

  nav a[aria-current="page"] {
    color: var(--ink);
    box-shadow: 0 2px 0 var(--accent);
  }

  #theme-toggle {
    margin-left: auto;
    display: grid;
    place-items: center;
    background: none;
    border: 0;
    padding: 0.35rem;
    border-radius: 8px;
    color: var(--muted);
    cursor: pointer;
  }

  #theme-toggle:hover {
    color: var(--ink);
    background: var(--bg-raised);
  }

  /* icon reflects the current theme: dark = crescent, light = sun */
  #theme-toggle .sun { display: none; }
  #theme-toggle .moon { display: block; }
  :global(html[data-theme="light"]) #theme-toggle .sun { display: block; }
  :global(html[data-theme="light"]) #theme-toggle .moon { display: none; }

  footer {
    width: min(var(--measure), 100% - 3rem);
    margin-inline: auto;
    padding-block: 1.5rem;
    border-top: 1px solid var(--hairline);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--muted);
  }

  .social {
    display: flex;
    gap: 1.5rem;
  }

  .social a {
    color: var(--muted);
    display: grid;
    place-items: center;
  }

  .social a:hover {
    color: var(--ink);
  }
</style>
